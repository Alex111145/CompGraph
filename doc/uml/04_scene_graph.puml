@startuml 04_scene_graph
!include style.iuml
title Scene graph del viewer
left to right direction

object "root : Node" as root
object "modello : Node\n(dal file .glb)" as model
object "SM_Bed_01_1_0 : Mesh\n(letto, sedia e scrivania)" as bed
object "Plane_2_0 : Mesh\n(pavimento)" as floor
object "DeskLamp : Node" as desk
object "base e paralume : Mesh\n(2 mesh)" as desklamp
object "LampLight : Node" as lampnode
object "LampLight : PointLight\n(dal file)" as lamp
object "torch : DirectionalLight\n(creata dal viewer)" as torch
object "free, front, corner camera : Camera" as cams

root *-- model
root *-- torch
root *-- cams
model *-- bed
model *-- floor
model *-- desk
desk *-- desklamp
desk *-- lampnode
lampnode *-- lamp
@enduml
