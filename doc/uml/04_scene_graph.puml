@startuml 04_scene_graph
!include style.iuml
title Scene graph del viewer
left to right direction

object "root : Node" as root
object "modello : Node\n(dal file .glb)" as model
object "letto, sedia, tavolo : Mesh" as bed
object "pavimento : Mesh" as floor
object "DeskLamp : Node" as desk
object "base + paralume : Mesh" as desklamp
object "LampLight : PointLight\n(dal file)" as lamp
object "torch : DirectionalLight\n(dal viewer)" as torch
object "3 camere : Camera" as cams

root *-- model
root *-- torch
root *-- cams
model *-- bed
model *-- floor
model *-- desk
desk *-- desklamp
desk *-- lamp
@enduml
