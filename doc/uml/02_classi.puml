@startuml 02_classi
!include style.iuml
title Classi del motore (namespace Eng)
hide empty members

class Base <<singleton>> {
  + init(title, width, height)
  + clearWindow()
  + render(camera, list, light)
  + swapBuffers()
  + free()
}
abstract class Object {
  + {abstract} render(modelView)
}
class Node {
  + setMatrix(matrix)
  + addChild(child)
}
class Mesh
class Camera
abstract class Light
class DirectionalLight
class PointLight
class Material
class Texture
class List {
  + pass(node)
}
class Loader {
  + {static} load(file) : Node
}

Object <|-- Node
Object <|-- Material
Object <|-- Texture
Object <|-- List
Node <|-- Mesh
Node <|-- Camera
Node <|-- Light
Light <|-- DirectionalLight
Light <|-- PointLight

Node *-- "0..*" Node : figli
Mesh o-- Material
Material o-- Texture
List o-- "0..*" Node : luci e mesh
Loader ..> Node : crea
Base ..> List : disegna
@enduml
