@startuml uml_classi
' REGOLA DEL COLORE: aggiunte n.1 e n.2 in BLU, n.3 in ROSSO, n.4 (24/11/2026) in VERDE, n.5 (24/11/2026) in VIOLA, n.6 (25/11/2026) in ARANCIONE.
' Aggiunta n.1 (11/11/2026, blu): lezione Graphics Engines 2 (List, Light, Material) + correzioni del prof (Camera, Mesh, Base).
' Aggiunta n.2 (12/11/2026, blu): mini legenda dei tasti, Base::drawText.
' Aggiunta n.3 (17/11/2026, rosso): lezione 6, caricamento scene con Assimp (Base::load, Mesh con lista vertici + lista facce).
' Aggiunta n.4 (24/11/2026, verde): camera libera da tastiera (Camera::move/turn, rilascio tasti e tasti speciali in Base).
' Aggiunta n.5 (24/11/2026, viola): lezione 7, texture mapping (classe Texture, coordinate texture nella Mesh, scacchiera procedurale).
' Aggiunta n.6 (25/11/2026, arancione): luci accese/spente da tastiera (Node::find, Light::setEnabled/isEnabled, Mesh::getMaterial).
!$AGG1 = "#0047C2"
!$AGG1_CLASSE = "#line:0047C2;text:0047C2"
!$AGG2 = "#0047C2"
!$AGG2_CLASSE = "#line:0047C2;text:0047C2"
!$AGG3 = "#C00000"
!$AGG3_CLASSE = "#line:C00000;text:C00000"
!$AGG4 = "#1E7B34"
!$AGG4_CLASSE = "#line:1E7B34;text:1E7B34"
!$AGG5 = "#7B1FA2"
!$AGG5_CLASSE = "#line:7B1FA2;text:7B1FA2"
!$AGG6 = "#E65100"
!$AGG6_CLASSE = "#line:E65100;text:E65100"

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam classFontSize 15
skinparam classFontStyle bold
skinparam packageFontSize 15
skinparam titleFontSize 20
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #E8EEF7
  BorderColor #2B3A55
  ArrowColor #2B3A55
  StereotypeFontSize 12
}
skinparam package {
  BorderColor #8090A8
  BackgroundColor #FBFCFE
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #8090A8
  FontSize 12
}
hide empty members

title Motore grafico — diagramma delle classi (namespace Eng)

package "namespace Eng  —  libreria del motore (DLL su Windows, .so su Linux)" as EngPkg {

  class Base <<singleton>> <<final>> {
    - reserved : std::unique_ptr<Reserved>
    + <color:$AGG4>{static} KEY_LEFT : const int = 100</color>
    + <color:$AGG4>{static} KEY_UP : const int = 101</color>
    + <color:$AGG4>{static} KEY_RIGHT : const int = 102</color>
    + <color:$AGG4>{static} KEY_DOWN : const int = 103</color>
    --
    - Base()
    + Base(other : const Base&) «= delete»
    + ~Base()
    + operator=(other : const Base&) : void «= delete»
    + {static} getInstance() : Base&
    .. init / free ..
    + init(title : const std::string&, width : int, height : int) : bool
    + free() : bool
    .. finestra (FreeGLUT) ..
    + setKeyboardCallback(callback : void (*)(unsigned char key, int mouseX, int mouseY)) : void
    + <color:$AGG4>setKeyboardUpCallback(callback : void (*)(unsigned char key, int mouseX, int mouseY)) : void</color>
    + <color:$AGG4>setSpecialKeyCallback(callback : void (*)(int key, int mouseX, int mouseY)) : void</color>
    + <color:$AGG4>setSpecialKeyUpCallback(callback : void (*)(int key, int mouseX, int mouseY)) : void</color>
    + setBackgroundColor(color : const glm::vec3&) : void
    + isRunning() : bool
    + clearWindow() : void
    + swapBuffers() : void
    + <color:$AGG1>getAspectRatio() : float {query}</color>
    .. caricamento ..
    + <color:$AGG3>load(fileName : const std::string&) : Node*</color>
    .. rendering ..
    + setWireframe(enabled : bool) : void
    + isWireframe() : bool {query}
    + <color:$AGG1>render(camera : const Camera&, list : const List&) : void</color>
    + <color:$AGG2>drawText(text : const std::string&, x : int, y : int, color : const glm::vec3&) : void</color>
    .. callback FreeGLUT ..
    - {static} displayCallback() : void
    - {static} reshapeCallback(width : int, height : int) : void
    - {static} closeCallback() : void
  }

  class "Base::Reserved" as Reserved <<struct>> {
    + initFlag : bool = false
    + running : bool = false
    + wireframe : bool = false
    + width : int = 0
    + height : int = 1
    + <color:$AGG3>loadedObjects : std::vector<std::unique_ptr<Object>></color>
    + <color:$AGG5>{static} checkerboardSize : constexpr int = 256</color>
    + <color:$AGG5>{static} checkerboardSquare : constexpr int = 32</color>
    --
    + Reserved()
    + <color:$AGG3>keep(object : std::unique_ptr<T>) : T*</color>
    + <color:$AGG5>{static} createCheckerboard() : std::vector<unsigned char></color>
    + <color:$AGG3>loadMaterial(fileMaterial : const aiMaterial*) : Material*</color>
    + <color:$AGG3>loadLight(fileLight : const aiLight*) : Light*</color>
    + <color:$AGG3>loadMesh(fileMesh : const aiMesh*, name : const std::string&, materials : const std::vector<Material*>&) : Mesh*</color>
    + <color:$AGG3>loadNode(fileScene : const aiScene*, fileNode : const aiNode*, materials : const std::vector<Material*>&) : Node*</color>
  }

  abstract class Object {
    - id : unsigned int
    - name : std::string
    - {static} nextId : unsigned int = 0
    --
    # Object(name : const std::string&)
    + Object(other : const Object&) «= delete»
    + ~Object() {virtual}
    + operator=(other : const Object&) : Object& «= delete»
    + getId() : unsigned int {query}
    + getName() : const std::string& {query}
    + setName(name : const std::string&) : void
    + {abstract} render(modelViewMatrix : const glm::mat4&) : void {query}
  }

  class Node {
    - matrix : glm::mat4 = identity
    - parent : Node* = nullptr
    - children : std::vector<Node*>
    --
    + Node(name : const std::string&)
    + ~Node() {override}
    .. matrici ..
    + setMatrix(matrix : const glm::mat4&) : void
    + getMatrix() : const glm::mat4& {query}
    + getWorldMatrix() : glm::mat4 {query}
    .. gerarchia ..
    + addChild(child : Node*) : bool
    + removeChild(child : Node*) : bool
    + getChild(index : unsigned int) : Node* {query}
    + getNumberOfChildren() : unsigned int {query}
    + getParent() : Node* {query}
    + <color:$AGG6>find(name : const std::string&) : Node*</color>
    .. rendering ..
    + render(modelViewMatrix : const glm::mat4&) : void {query, override}
  }

  class Material $AGG1_CLASSE {
    - emission : glm::vec4 = (0, 0, 0, 1)
    - ambient : glm::vec4 = (0.2, 0.2, 0.2, 1)
    - diffuse : glm::vec4 = (0.8, 0.8, 0.8, 1)
    - specular : glm::vec4 = (0.5, 0.5, 0.5, 1)
    - shininess : float = 128
    --
    + Material(name : const std::string&)
    + setEmission(emission : const glm::vec4&) : void
    + setAmbient(ambient : const glm::vec4&) : void
    + setDiffuse(diffuse : const glm::vec4&) : void
    + setSpecular(specular : const glm::vec4&) : void
    + setShininess(shininess : float) : void
    + render(modelViewMatrix : const glm::mat4&) : void {query, override}
  }

  class Texture $AGG5_CLASSE {
    - texId : unsigned int
    --
    + Texture(name : const std::string&, width : int, height : int, bitmap : const unsigned char*)
    + ~Texture()
    + render(modelViewMatrix : const glm::mat4&) : void {query, override}
  }

  class Mesh {
    - <color:$AGG3>positions : std::vector<glm::vec3></color>
    - <color:$AGG3>normals : std::vector<glm::vec3></color>
    - <color:$AGG5>texCoords : std::vector<glm::vec2></color>
    - <color:$AGG3>faces : std::vector<glm::uvec3></color>
    - <color:$AGG1>material : const Material* = nullptr</color>
    --
    + <color:$AGG3>Mesh(name : const std::string&)</color>
    + <color:$AGG5>addVertex(position : const glm::vec3&, normal : const glm::vec3&, texCoord : const glm::vec2&) : void</color>
    + <color:$AGG3>addFace(vertex0 : unsigned int, vertex1 : unsigned int, vertex2 : unsigned int) : bool</color>
    + <color:$AGG1>setMaterial(material : const Material*) : void</color>
    + <color:$AGG6>getMaterial() : const Material* {query}</color>
    + render(modelViewMatrix : const glm::mat4&) : void {query, override}
  }

  class Light $AGG1_CLASSE {
    - type : Type
    - lightNumber : int = -1
    - ambient : glm::vec4 = (0, 0, 0, 1)
    - diffuse : glm::vec4 = (1, 1, 1, 1)
    - specular : glm::vec4 = (1, 1, 1, 1)
    - cutoff : float = 30
    - <color:$AGG6>enabled : bool = true</color>
    - {static} nextLightNumber : int = 0
    --
    + Light(name : const std::string&, type : Type)
    + setAmbient(ambient : const glm::vec4&) : void
    + setDiffuse(diffuse : const glm::vec4&) : void
    + setSpecular(specular : const glm::vec4&) : void
    + setCutoff(cutoff : float) : bool
    + <color:$AGG6>setEnabled(enabled : bool) : void</color>
    + <color:$AGG6>isEnabled() : bool {query}</color>
    + render(modelViewMatrix : const glm::mat4&) : void {query, override}
  }

  enum "Light::Type" as LightType <<enum class>> $AGG1_CLASSE {
    DIRECTIONAL
    OMNI
    SPOT
  }

  class Camera {
    - <color:$AGG1>projectionMatrix : glm::mat4 = identity</color>
    --
    + Camera(name : const std::string&)
    + <color:$AGG1>setProjectionMatrix(projectionMatrix : const glm::mat4&) : void</color>
    + <color:$AGG1>getProjectionMatrix() : const glm::mat4& {query}</color>
    + <color:$AGG1>getInverseMatrix() : glm::mat4 {query}</color>
    .. movimento ..
    + <color:$AGG4>move(offset : const glm::vec3&) : void</color>
    + <color:$AGG4>turn(angle : float) : void</color>
  }

  class List $AGG1_CLASSE {
    - instances : std::vector<Instance>
    --
    + List(name : const std::string&)
    + pass(node : const Node*, parentMatrix : const glm::mat4& = identity) : void
    + clear() : void
    + render(cameraInverseMatrix : const glm::mat4&) : void {query, override}
  }

  class "List::Instance" as Instance <<struct>> $AGG1_CLASSE {
    + nodePtr : const Node*
    + nodeWorldMatrix : glm::mat4
  }
}

Base *-- "1" Reserved : reserved
Base -[$AGG3]..> Node : <<use>>\nload()
Reserved -[$AGG3]..> Material : <<create>>\nloadMaterial()
Reserved -[$AGG5]..> Texture : <<create>>\nloadMaterial()
Reserved -[$AGG3]..> Light : <<create>>\nloadLight()
Reserved -[$AGG3]..> Mesh : <<create>>\nloadMesh()
Reserved -[$AGG3]..> Node : <<create>>\nloadNode()
Reserved *-[$AGG3]- "0..*" Object : loadedObjects\n(possiede)
Base ..> Camera : <<use>>\nrender()
Base -[$AGG1]..> List : <<use>>\nrender()

Object <|-- Node
Object <|-[$AGG1]- Material
Material <|-[$AGG5]- Texture
Object <|-[$AGG1]- List
Node <|-- Mesh
Node <|-[$AGG1]- Light
Node <|-- Camera
Node "0..1\nparent" o-- "0..*\nchildren" Node

Mesh o-[$AGG1]-> "0..1" Material : material\n(non posseduto)
Light +-[$AGG1]- LightType : type
List *-[$AGG1]- "0..*" Instance : instances
Instance -[$AGG1]-> "1" Node : nodePtr

legend bottom left
  **Legenda**
  + public    - private    # protected
  {static} = membro statico (sottolineato)    {abstract} = metodo virtuale puro (corsivo)
  {query} = metodo const    {override} = ridefinisce il metodo della classe padre
  «= delete» = funzione cancellata (oggetto non copiabile)
  rombo pieno = composizione    rombo vuoto = aggregazione    tratteggio = dipendenza (usa)
  <color:$AGG1>**blu = aggiunte n.1 e n.2**</color>
  <color:$AGG3>**rosso = aggiunta n.3**</color>
  <color:$AGG4>**verde = aggiunta n.4**</color>
  <color:$AGG5>**viola = aggiunta n.5**</color>
  <color:$AGG6>**arancione = aggiunta n.6**</color>
endlegend
@enduml
