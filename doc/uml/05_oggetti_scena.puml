@startuml 05_oggetti_scena
!include style.iuml
title Diagramma degli oggetti: scene graph a runtime (bedroom .glb)

object "root : Node" as root
object "ROOT : Node" as ROOT
object "DeskLamp : Node" as desk
object "Cylinder-0 : Mesh" as c0 {
  triangoli = 248
}
object "Cylinder-1 : Mesh" as c1 {
  triangoli = 62
  emissione > 0 (paralume)
}
object "Sketchfab_model : Node" as sk
object "Plane_2_0 : Mesh" as plane {
  triangoli = 32
  isFlat() = true (pavimento)
}
object "SM_Bed_01_1_0 : Mesh" as bed {
  triangoli = 14495
}
object "torch : DirectionalLight" as torch {
  matrice = mondo camera attiva
}
object "lamp : PointLight" as lamp {
  matrice = centro del paralume
  attenuazione = (1, 4.2, 12.4)
}
object "free camera : Camera" as cam0
object "front camera : Camera" as cam1
object "top camera : Camera" as cam2
object "render list : List" as list {
  lights = [torch, lamp]
  meshes = [Cylinder-0, Cylinder-1, Plane_2_0, SM_Bed_01_1_0]
}

root *-- ROOT
root *-- torch
root *-- lamp
root *-- cam0
root *-- cam1
root *-- cam2
ROOT *-- desk
ROOT *-- sk
desk *-- c0
desk *-- c1
sk *-- plane : nodi intermedi\n(.fbx, RootNode, Plane)
sk *-- bed : nodi intermedi\n(.fbx, RootNode, SM_Bed_01)

list ..> root : pass(root)

note bottom of list
  La lista non possiede i nodi: tiene solo puntatori.
  Le luci sono disegnate prima delle mesh.
end note
note right of root
  Ogni Node possiede i figli (delete root
  distrugge tutto). I Material e le Texture
  sono condivisi con shared_ptr.
end note
@enduml
