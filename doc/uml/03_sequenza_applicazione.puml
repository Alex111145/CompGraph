@startuml 03_sequenza_applicazione
!include style.iuml
title Sequenza: ciclo di vita del viewer
autonumber
hide footbox

actor Utente
participant "main()\n(client)" as main
participant "eng : Base" as eng
participant "FreeGLUT\n(interno)" as glut
participant "Loader" as loader
participant "list : List" as list

== Avvio ==
main -> eng : getInstance()
main -> eng : init("3D model viewer", 1024, 768)
eng -> glut : glutInit, glutInitDisplayMode(DOUBLE|RGBA|DEPTH|STENCIL)
eng -> glut : glutCreateWindow + callback (tastiera, mouse, chiusura)
main -> eng : setKeyboardCallback(keyboardCallback)
main -> eng : setBackgroundColor(colore)
main -> loader : load("...glb")
loader --> main : model : Node*
main -> main : crea DirectionalLight "torch",\nPointLight "lamp", 3 Camera\ne le aggiunge a root
main -> list : pass(root)
note right of list : luci e mesh raccolte una volta;\nle matrici mondo si leggono a ogni frame

== Ciclo principale (ogni frame) ==
loop eng.isRunning()
  main -> eng : getDeltaTime(), getMouseDelta(), isKeyDown('W')...
  main -> main : moveFreeCamera(), torch segue la camera attiva
  main -> eng : clearWindow()
  main -> eng : render(camera, &list, lamp)
  main -> eng : renderLegend(LEGEND)
  main -> eng : swapBuffers()
  eng -> glut : glutSwapBuffers()
  eng -> glut : glutMainLoopEvent()
  opt tasto premuto
    Utente -> glut : tasto 'C' / '1' / '2' / 'P'
    glut -> eng : keyDownCallback(key)
    eng -> main : keyboardCallback(KEY)
    main -> main : cambia camera / accende-spegne luce / stampa
  end
  opt ESC o finestra chiusa
    glut -> eng : keyDownCallback(ESC) / windowCloseCallback()
    eng -> eng : running = false
  end
end

== Chiusura ==
main -> list : clear()
main -> main : delete root (distrugge tutto lo scene graph)
main -> eng : free()
eng -> glut : glutDestroyWindow, glutExit
@enduml
